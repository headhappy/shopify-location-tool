# Copy these into your private environment only after reviewing the PR.
BUNDLE_BUILDER_ENABLED=false
BUNDLE_APP_ORIGIN=http://localhost:3000
BUNDLE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
BUNDLE_SHOPIFY_API_VERSION=2026-10
# Individual accounts; generate each hash with npm run bundle:password (stdin).
BUNDLE_STAFF_USERS=[]
# Existing SHOPIFY_SHOP and SHOPIFY_ACCESS_TOKEN are reused, never exposed to browsers.
